<ui:FluentWindow x:Class="OrbSpoofer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:OrbSpoofer"
        Title="OrbSpoofer" Height="700" Width="1000"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        Icon="OS.png"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="4" Background="#66000000"/>

        <!-- Fluent TitleBar (Mica) -->
        <ui:TitleBar Grid.Row="0" Title="OrbSpoofer" Icon="OS.png" Height="48" Padding="12,0" Background="Transparent"/>

        <!-- Header -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="28,20">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="OS.png" Width="32" Height="32" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OrbSpoofer" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" FontFamily="{StaticResource HeaderFont}"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" FontFamily="{StaticResource BodyFont}">
                            <Run Text="Discord Orb Quest Spoofer"/>
                            <Run Text=" · " Foreground="{StaticResource TextMutedBrush}"/>
                            <Run x:Name="HeaderStatusText" Text="Loading..." Foreground="{StaticResource WarningBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Free games bell (Bridge-style) -->
                    <Grid Width="40" Height="40" Margin="0,0,8,0">
                        <Button x:Name="BellButton" Width="40" Height="40" Padding="0" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Click="BellButton_Click"
                                ToolTip="Free games" AutomationProperties.Name="Free games">
                            <ui:SymbolIcon x:Name="BellIcon" Symbol="Alert24" FontSize="20">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnseenFreeGames, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Button>
                        <Border x:Name="BellBadge" Width="16" Height="16" CornerRadius="8" Background="#FF4444"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                IsHitTestVisible="False" Visibility="Collapsed">
                            <TextBlock x:Name="BellBadgeCount" Text="" FontSize="9" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Border>
                    </Grid>
                    <ui:Button x:Name="BtnToggleSidebar" Appearance="Secondary" Padding="8,6" Margin="0,0,8,0"
                            ToolTip="Toggle sidebar" Click="BtnToggleSidebar_Click">
                        <ui:SymbolIcon Symbol="Navigation24" FontSize="16"/>
                    </ui:Button>
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Free games popup -->
        <Popup x:Name="NotificationsPopup" AllowsTransparency="True" PopupAnimation="Fade"
               Focusable="False" StaysOpen="True" Placement="Relative">
            <Border CornerRadius="12" Background="#F0141414" BorderBrush="{StaticResource Orb.SeparatorBrush}"
                    BorderThickness="1" Width="360" MaxHeight="480">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="14,12"
                            CornerRadius="12,12,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Alert24" FontSize="16" Foreground="White" Margin="0,0,8,0"/>
                                <TextBlock Text="Free games" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                <Border Background="#33FFFFFF" CornerRadius="8" Padding="6,2" Margin="10,0,0,0" x:Name="PopupBadgePill">
                                    <TextBlock x:Name="PopupBadgeText" Text="" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <Button x:Name="BtnMarkAllSeen" HorizontalAlignment="Right" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" Click="BtnMarkAllSeen_Click"
                                    ToolTip="Mark as seen">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8,8,0">
                        <StackPanel>
                            <ItemsControl x:Name="FreeGamesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" CornerRadius="10"
                                                Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="56" Height="56" CornerRadius="8" Margin="0,0,10,0">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="6" Padding="6,1">
                                                            <TextBlock Text="{Binding PlatformLabel}" FontSize="10" Foreground="White"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Worth}" FontSize="11"
                                                                   Foreground="{StaticResource SuccessBrush}" Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Background="#5865F2" Foreground="White" BorderThickness="0"
                                                        Padding="10,6" Cursor="Hand" VerticalAlignment="Center"
                                                        Click="FreeGameClaim_Click" Tag="{Binding}"
                                                        ToolTip="Open giveaway">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Claim" FontSize="11" VerticalAlignment="Center" Foreground="White"/>
                                                        <ui:SymbolIcon Symbol="Open24" FontSize="12" Margin="4,0,0,0" Foreground="White"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="FreeGamesEmpty" Text="No free games right now. Check back soon!"
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Padding="0,20,0,16" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Padding="8" BorderBrush="{StaticResource Orb.SeparatorBrush}" BorderThickness="0,1,0,0">
                        <Button HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand"
                                Click="BtnRefreshFreeGames_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Popup>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation — collapsible (Fluent compact) -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Width="220" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,16">
                    <TextBlock Text="M  O  D  E  S" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,12"
                               FontFamily="{StaticResource BodyFont}"/>

                    <ui:Button x:Name="BtnQuests" Appearance="Secondary" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="12,10" FontSize="13" Margin="0,0,0,6"
                            Click="BtnQuests_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Trophy24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Active Quests" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="BtnUnifiedSearch" Appearance="Secondary" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="12,10" FontSize="13" Margin="0,0,0,6"
                            Click="BtnUnifiedSearch_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Search24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Search" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <TextBlock x:Name="AdvancedToggle" Text="▸  Advanced"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="8,10,0,8" Cursor="Hand"
                               MouseLeftButtonDown="AdvancedToggle_Click"/>
                    <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="8,0,0,0">
                        <ui:Button x:Name="BtnDatabase" Appearance="Secondary" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" Padding="12,10" FontSize="13" Margin="0,0,0,6"
                                Click="BtnDatabase_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Database24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Discord Database" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="BtnSteam" Appearance="Secondary" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" Padding="12,10" FontSize="13" Margin="0,0,0,6"
                                Click="BtnSteam_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Games24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Steam Quest" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="BtnManual" Appearance="Secondary" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" Padding="12,10" FontSize="13" Margin="0,0,0,6"
                                Click="BtnManual_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Wrench24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Manual Mode" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,12,0,12"/>

                    <TextBlock Text="I  N  F  O" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,12"
                               FontFamily="{StaticResource BodyFont}"/>

                    <ui:Button x:Name="BtnCredits" Appearance="Secondary" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="12,10" FontSize="13" Margin="0,0,0,6"
                            Click="BtnCredits_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Credits &amp; Info" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="BtnUpdateReminder" Appearance="Secondary" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="12,10" FontSize="13" Margin="0,0,0,6"
                            Visibility="Collapsed"
                            Foreground="{StaticResource WarningBrush}"
                            Click="UpdateReminder_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowUp24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Update Available" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,12,0,12"/>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Column="1" Margin="28,24">

                <!-- Loading State � Fluent ProgressRing -->
                <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Visible">
                    <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,16"/>
                    <TextBlock x:Name="LoadingText" Text="Loading..."
                               FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Unified Search View -->
                <Grid x:Name="UnifiedSearchView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Search" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Bottom" Margin="0,28,0,0"
                               Text="One result per game. Badge shows Discord, Steam, or Both. Use Advanced to pick a source."/>

                    <Grid Grid.Row="1" Margin="0,16,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="UnifiedSearchBox" Grid.Column="0"
                                 PlaceholderText="Search games..."
                                 KeyDown="UnifiedSearchBox_KeyDown"
                                 TextChanged="UnifiedSearchBox_TextChanged"
                                 VerticalContentAlignment="Center"/>
                        <ui:Button x:Name="BtnUnifiedSearchGo" Grid.Column="1" Content="Search"
                                Appearance="Primary" Background="#5865F2" Foreground="White" BorderBrush="#5865F2" Margin="10,0,0,0"
                                Click="BtnUnifiedSearchGo_Click"/>
                    </Grid>

                    <ListBox x:Name="UnifiedResultsList" Grid.Row="2" Padding="0,0,20,0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="UnifiedResultsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Orb.Card}" Margin="0,16,0,6"
                                        ToolTip="Double-click to spoof">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="92" Height="48" CornerRadius="8"
                                                Background="{StaticResource SurfaceBrush}"
                                                Margin="0,0,14,0">
                                            <Grid>
                                                <TextBlock Text="??" FontSize="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Image Source="{Binding ImageUrl}" Width="92" Height="48"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="360"/>
                                                <Border Margin="10,0,0,0" CornerRadius="4" Padding="8,2"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#2a2a2a"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Badge}" Value="Discord">
                                                                    <Setter Property="Background" Value="#5865F2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Badge}" Value="Steam">
                                                                    <Setter Property="Background" Value="#1b2838"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Badge}" Value="Both">
                                                                    <Setter Property="Background" Value="#1a5c3a"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="#ffffff"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,4,0,0" Text="{Binding Subtitle}"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" 
                                                Appearance="Primary" Background="#5865F2" Foreground="White" BorderBrush="#5865F2"
                                                Padding="8" Width="60" Height="60"
                                                FontSize="24"
                                                Tag="{Binding}"
                                                ToolTip="Spoof"
                                                Click="UnifiedSpoof_Click"><ui:SymbolIcon Symbol="Play24" Foreground="White" FontSize="20"/></ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="UnifiedNoResultsText" Grid.Row="2"
                               Text="Type a game name or process.exe and press Search"
                               FontSize="15" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Visible"/>
                </Grid>

                <!-- Database Search View -->
                <Grid x:Name="DatabaseView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Discord Database" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Bottom" Margin="0,28,0,0">
                        <Run x:Name="DbSourceText" Text=""/>
                    </TextBlock>

                    <Grid Grid.Row="1" Margin="0,16,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="SearchBox" Grid.Column="0"
                                 PlaceholderText="Search games..."
                                 
                                 KeyDown="SearchBox_KeyDown"
                                 TextChanged="SearchBox_TextChanged"
                                 VerticalContentAlignment="Center"/>
                        <ui:Button x:Name="BtnSearch" Grid.Column="1" Content="Search"
                                Appearance="Primary" Background="#5865F2" Foreground="White" BorderBrush="#5865F2" Margin="10,0,0,0"
                                Click="BtnSearch_Click"/>
                    </Grid>

                    <ListBox x:Name="ResultsList" Grid.Row="2" Padding="0,0,20,0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="ResultsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                 <Border Style="{StaticResource Orb.Card}" Margin="0,16,0,6"
                                         ToolTip="Double-click to spoof">
                                     <Grid>
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto"/>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="Auto"/>
                                         </Grid.ColumnDefinitions>
                                         <Border Grid.Column="0" Width="92" Height="48" CornerRadius="8"
                                                 Background="{StaticResource SurfaceBrush}"
                                                 Margin="0,0,14,0">
                                             <Grid>
                                                 <TextBlock Text="??" FontSize="20"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                 <Image Source="{Binding ImageUrl}" Width="92" Height="48"
                                                        Stretch="Uniform"
                                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                             </Grid>
                                         </Border>
                                         <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                             <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                        Foreground="{StaticResource TextPrimaryBrush}"/>
                                             <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                        Margin="0,4,0,0">
                                                 <Run Text="ID: "/>
                                                 <Run Text="{Binding Id, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"/>
                                             </TextBlock>
                                             <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                        Margin="0,2,0,0" Text="{Binding AliasDisplay}"/>
                                         </StackPanel>
                                         <ui:Button Grid.Column="2" 
                                                 Appearance="Primary" Background="#5865F2" Foreground="White" BorderBrush="#5865F2"
                                                 Padding="8" Width="60" Height="60"
                                                 FontSize="24"
                                                 Tag="{Binding}"
                                                 ToolTip="Spoof"
                                                 Click="SpoofGame_Click"><ui:SymbolIcon Symbol="Play24" Foreground="White" FontSize="20"/></ui:Button>
                                     </Grid>
                                 </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="NoResultsText" Grid.Row="2"
                               Text="Type the game name and click ? to spoof"
                               FontSize="15" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Visible"/>
                </Grid>

                <!-- Manual Mode View -->
                <Grid x:Name="ManualView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Manual Mode" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Bottom" Margin="0,28,0,0"
                               Text="Enter the exact process name Discord expects"/>

                    <Border Grid.Row="1" Style="{StaticResource Orb.Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Examples:" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,4" Text="� TslGame.exe (PUBG)"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,4" Text="� League of Legends.exe (LoL)"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       Text="� Overwatch.exe"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="ManualExeBox" Grid.Column="0"
                                 PlaceholderText="e.g. TslGame.exe"
                                 TextChanged="ManualExeBox_TextChanged"
                                 VerticalContentAlignment="Center"/>
                         <ui:Button x:Name="BtnManualSpoof" Grid.Column="1" 
                                 Appearance="Primary" Background="#5865F2" Foreground="White" BorderBrush="#5865F2" Margin="10,0,0,0"
                                 Padding="8" Width="60" Height="60" FontSize="24"
                                 ToolTip="Spoof"
                                 IsEnabled="False"
                                 Click="BtnManualSpoof_Click"><ui:SymbolIcon Symbol="Play24" Foreground="White" FontSize="20"/></ui:Button>
                    </Grid>

                    <Border x:Name="ManualResultPanel" Grid.Row="3" Visibility="Collapsed"
                            Style="{StaticResource Orb.Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ManualResultText" FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Steam Quest View -->
                <Grid x:Name="SteamView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Steam Quest Mode" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Bottom" Margin="0,28,0,0"
                               Text="Generates a fake Steam appmanifest for games that verify Steam ownership"/>

                    <Border Grid.Row="1" Style="{StaticResource Orb.Card}"
                            Padding="14" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Steam:" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBlock x:Name="SteamPathText" Grid.Column="1" Text="Detecting..."
                                       FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="SteamSearchBox" Grid.Column="0"
                                 PlaceholderText="Search games..."
                                 
                                 KeyDown="SteamSearchBox_KeyDown"
                                 TextChanged="SteamSearchBox_TextChanged"
                                 VerticalContentAlignment="Center"/>
                        <ui:Button x:Name="BtnSteamSearch" Grid.Column="1" Content="Search"
                                Appearance="Primary" Background="#5865F2" Foreground="White" BorderBrush="#5865F2" Margin="10,0,0,0"
                                Click="BtnSteamSearch_Click"/>
                    </Grid>

                    <ListBox x:Name="SteamResultsList" Grid.Row="3" Padding="0,0,20,0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0"
                             Margin="0,12,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="SteamResultsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                 <Border Style="{StaticResource Orb.Card}" Margin="0,16,0,6"
                                         ToolTip="Double-click to spoof">
                                     <Grid>
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto"/>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="Auto"/>
                                         </Grid.ColumnDefinitions>
                                         <Border Grid.Column="0" Width="92" Height="48" CornerRadius="8"
                                                 Background="{StaticResource SurfaceBrush}"
                                                 Margin="0,0,14,0">
                                             <Image Source="{Binding ImageUrl}" Width="92" Height="48"
                                                    Stretch="Uniform"
                                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                                         </Border>
                                         <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                             <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                        Foreground="{StaticResource TextPrimaryBrush}"/>
                                             <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                        Margin="0,4,0,0">
                                                 <Run Text="AppID: "/>
                                                 <Run Text="{Binding Id, Mode=OneWay}"/>
                                             </TextBlock>
                                         </StackPanel>
                                           <ui:Button Grid.Column="2" 
                                                   Appearance="Primary" Background="#5865F2" Foreground="White" BorderBrush="#5865F2"
                                                   Padding="8" Width="60" Height="60"
                                                   FontSize="24"
                                                   Tag="{Binding}"
                                                   ToolTip="Spoof"
                                                   Click="SteamSpoof_Click"><ui:SymbolIcon Symbol="Play24" Foreground="White" FontSize="20"/></ui:Button>
                                      </Grid>
                                  </Border>
                             </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="SteamNoResultsText" Grid.Row="3"
                               Text="Search a Steam game and click ? to spoof"
                               FontSize="15" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Quests View -->
                <Grid x:Name="QuestsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Active Quests" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <ui:Button x:Name="BtnRunAllQuests" HorizontalAlignment="Right" Appearance="Primary"
                                   Background="#5865F2" Foreground="White" BorderBrush="#5865F2"
                                   Padding="14,7" FontSize="13" Cursor="Hand"
                                   Click="BtnRunAllQuests_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="RunAllIcon" Symbol="Play24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                <TextBlock x:Name="RunAllText" Text="Run all quests" VerticalAlignment="Center" Foreground="White"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                    <ui:InfoBar Grid.Row="1" Margin="0,0,0,16" IsOpen="True" IsClosable="False"
                               Severity="Informational" Title="Heads up"
                               Message="Quests vary by region and availability. If there's nothing here, open Search and type the game name."/>

                    <TextBlock x:Name="QuestsLoadingText" Grid.Row="2" Text="Loading quests..."
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="QuestsEmptyText" Grid.Row="2"
                               FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    <ListBox x:Name="QuestsList" Grid.Row="2" Padding="0,0,20,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="Transparent" Padding="0">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                  <Border Margin="0,16,24,10"
                                         ToolTip="Double-click to spoof">
                                      <Border.Style>
                                         <Style TargetType="Border" BasedOn="{StaticResource Orb.Card}">
                                             <Style.Triggers>
                                                 <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                     <Setter Property="Opacity" Value="0.45"/>
                                                 </DataTrigger>
                                             </Style.Triggers>
                                         </Style>
                                     </Border.Style>
                                     <Grid>
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto"/>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="Auto"/>
                                             <ColumnDefinition Width="Auto"/>
                                         </Grid.ColumnDefinitions>

                                         <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8"
                                                 Background="{StaticResource SurfaceBrush}"
                                                 Margin="0,0,14,0">
                                             <Image Source="{Binding ImageUrl}" Width="64" Height="64"
                                                    Stretch="UniformToFill"
                                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                                         </Border>

                                         <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                             <TextBlock Text="{Binding GameName}" FontSize="15" FontWeight="SemiBold"
                                                        Foreground="{StaticResource TextPrimaryBrush}">
                                                 <TextBlock.Style>
                                                     <Style TargetType="TextBlock">
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                 <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </TextBlock.Style>
                                             </TextBlock>
                                             <TextBlock Text="{Binding QuestName}" FontSize="12"
                                                        Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                 <TextBlock.Style>
                                                     <Style TargetType="TextBlock">
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                 <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </TextBlock.Style>
                                             </TextBlock>
                                             <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                 <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                                     <Run Text="{Binding Reward, Mode=OneWay}"/>
                                                 </TextBlock>
                                                 <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                            Margin="12,0,0,0">
                                                     <Run Text="{Binding TaskMinutes, Mode=OneWay}"/>
                                                     <Run Text=" min"/>
                                                 </TextBlock>
                                                 <TextBlock FontSize="11" Foreground="{StaticResource WarningBrush}"
                                                            Margin="12,0,0,0">
                                                     <Run Text="Ends "/>
                                                     <Run Text="{Binding ExpiresAt, Mode=OneWay, StringFormat={}{0:MMM d}}"/>
                                                 </TextBlock>
                                                 <TextBlock FontSize="11" Foreground="{StaticResource WarningBrush}"
                                                            Margin="12,0,0,0">
                                                     <TextBlock.Style>
                                                         <Style TargetType="TextBlock">
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding NeedsSteamMode}" Value="True">
                                                                     <Setter Property="Visibility" Value="Visible"/>
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                             <Setter Property="Visibility" Value="Collapsed"/>
                                                         </Style>
                                                     </TextBlock.Style>
                                                     <Run Text="? Steam required"/>
                                                 </TextBlock>
                                             </StackPanel>
                                         </StackPanel>

                                         <Border Grid.Column="2" Width="32" Height="32"
                                                 CornerRadius="16" Cursor="Hand" Tag="{Binding}"
                                                 ToolTip="Toggle completed"
                                                 BorderThickness="1.5"
                                                 Background="{StaticResource SurfaceBrush}"
                                                 BorderBrush="{StaticResource TextMutedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,10,0"
                                                 PreviewMouseLeftButtonDown="QuestCompleteToggle_Click">
                                             <Border.Style>
                                                 <Style TargetType="Border">
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                             <Setter Property="Background" Value="#4CAF50"/>
                                                             <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Border.Style>
                                              <TextBlock Text="✓" FontSize="14" FontWeight="Bold"
                                                         Foreground="White" HorizontalAlignment="Center"
                                                         VerticalAlignment="Center">
                                                  <TextBlock.Style>
                                                      <Style TargetType="TextBlock">
                                                          <Setter Property="Visibility" Value="Hidden"/>
                                                          <Style.Triggers>
                                                              <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                  <Setter Property="Visibility" Value="Visible"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </TextBlock.Style>
                                             </TextBlock>
                                         </Border>

                                         <ui:Button Grid.Column="3" 
                                                 Appearance="Primary" Background="#5865F2" Foreground="White" BorderBrush="#5865F2"
                                                  Padding="8" Width="60" Height="60"
                                                  FontSize="24"
                                                  Tag="{Binding}"
                                                  ToolTip="Spoof"
                                                 Click="QuestsSpoof_Click"><ui:SymbolIcon Symbol="Play24" Foreground="White" FontSize="20"/></ui:Button>
                                     </Grid>
                                 </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Credits View -->
                <Grid x:Name="CreditsView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8">
                            <TextBlock Text="Credits &amp; Info" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                            <Border x:Name="CreditAbout" Style="{StaticResource Orb.Card}"
                                    Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="About" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22">
                                        OrbSpoofer is a game process spoofer that tricks Discord into thinking
                                        you're running a game by creating fake processes with the exact names
                                        Discord expects. No client modification. No code injection.
                                    </TextBlock>
                                    <TextBlock Margin="0,12,0,0">
                                        <Hyperlink NavigateUri="https://github.com/ZavalaSebas/OrbSpoofer" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#5865F2" TextDecorations="Underline">View on GitHub — ZavalaSebas/OrbSpoofer →</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CreditHowItWorks" Style="{StaticResource Orb.Card}"
                                    Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="How it works" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22">
                                        <Run>1. Your active Discord quests appear automatically on launch</Run>
                                        <LineBreak/>
                                        <Run>2. Double-click a quest or press ? to start spoofing</Run>
                                        <LineBreak/>
                                        <Run>3. OrbSpoofer finds the exact process name Discord expects</Run>
                                        <LineBreak/>
                                        <Run>4. Copies the app executable and renames it to match</Run>
                                        <LineBreak/>
                                        <Run>5. Launches the fake process in background</Run>
                                        <LineBreak/>
                                        <Run>6. Discord scans running processes and detects the fake process</Run>
                                        <LineBreak/>
                                        <Run>7. Discord thinks you're playing the game</Run>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CreditSteam" Style="{StaticResource Orb.Card}"
                                    Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Steam Quest Mode" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22">
                                        Some games (Marathon, Toxic Commando...) require Discord to verify
                                        that Steam has partially downloaded them. This mode generates a fake
                                        appmanifest and places the executable in the correct Steam directory.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CreditDisclaimer" Style="{StaticResource Orb.Card}"
                                    Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="? Disclaimer" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource WarningBrush}" Margin="0,0,0,10"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22">
                                        OrbSpoofer is a Discord automation tool built for educational
                                        purposes. It automates a manual process using Discord's public
                                        API and process detection. You are solely responsible for
                                        complying with Discord's Terms of Service. Use at your own risk.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CreditSupport" Style="{StaticResource Orb.Card}"
                                    Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <ui:SymbolIcon Symbol="Heart24" FontSize="16" Foreground="{StaticResource ErrorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Support" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22"
                                               Margin="0,0,0,14">
                                        Enjoying OrbSpoofer? Your support keeps the project alive!
                                    </TextBlock>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0" Appearance="Primary" Background="#5865F2" Foreground="White" BorderBrush="#5865F2"
                                                Padding="16,8" FontSize="13" Cursor="Hand"
                                                Click="Kofi_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Heart24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="Buy me a coffee" VerticalAlignment="Center" Foreground="White"/>
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button Grid.Column="2" Appearance="Primary" Background="#5865F2" Foreground="White" BorderBrush="#5865F2"
                                                Padding="16,8" FontSize="13" Cursor="Hand"
                                                Click="GitHubSponsor_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Heart24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="GitHub Sponsor" VerticalAlignment="Center" Foreground="White"/>
                                            </StackPanel>
                                        </ui:Button>
                                        </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,16,0,4">
                                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="Original concept by "/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{StaticResource PrimaryBrush}"
                                           Cursor="Hand" MouseLeftButtonDown="Strykey_Click"
                                           Text="Strykey" Margin="0,0,0,0"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                           Text=" · "/>
                                <TextBlock FontSize="12" Foreground="{StaticResource PrimaryBrush}"
                                           Cursor="Hand" MouseLeftButtonDown="Orbshacker_Click"
                                           Text="orbshacker"/>
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Cursor="Hand" MouseLeftButtonDown="GitHubProfile_Click">
                                <Run Text="Made with love by "/>
                                <Run Text="ZavalaSebas" Foreground="{StaticResource PrimaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                             Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusMessage" Text="Ready"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="GameCount" Text=""
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <ui:SymbolIcon Symbol="Heart24" FontSize="16" Foreground="{StaticResource ErrorBrush}"
                               VerticalAlignment="Center" Margin="14,0,0,0" Cursor="Hand"
                               ToolTip="Enjoying OrbSpoofer? Buy me a coffee!"
                               MouseLeftButtonDown="Kofi_HeartClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
