<ui:FluentWindow x:Class="OrbSpoofer.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:OrbSpoofer.Views"
        Title="OrbSpoofer" Height="700" Width="1000"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        Icon="OS.png"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="4" Background="#66000000"/>
        <ui:TitleBar Grid.Row="0" Title="OrbSpoofer" Icon="OS.png" Height="48" Padding="12,0" Background="Transparent"/>

        <!-- Header -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="OS.png" Width="32" Height="32" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OrbSpoofer" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" FontFamily="{StaticResource HeaderFont}"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" FontFamily="{StaticResource BodyFont}">
                            <Run Text="Discord Orb Quest Spoofer"/><Run Text=" · " Foreground="{StaticResource TextMutedBrush}"/><Run Text="{Binding HeaderStatus, Mode=OneWay}" Foreground="{StaticResource WarningBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid Width="40" Height="40" Margin="0,0,8,0">
                        <Button x:Name="BellButton" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BellButton_Click" ToolTip="Free games">
                            <ui:SymbolIcon Symbol="Alert24" FontSize="20">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FreeGames.HasUnseen}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Button>
                        <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource ErrorBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" IsHitTestVisible="False"
                                Visibility="{Binding FreeGames.HasUnseen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding FreeGames.UnseenCount}" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Border>
                    </Grid>
                    <Button x:Name="AccentButton" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="AccentButton_Click" ToolTip="Accent color">
                        <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Orb.SystemAccentBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                    </Button>
                    <ui:Button Appearance="Secondary" Padding="8,6" Margin="0,0,8,0" ToolTip="Toggle sidebar" Command="{Binding ToggleSidebarCommand}">
                        <ui:SymbolIcon Symbol="Navigation24" FontSize="16"/>
                    </ui:Button>
                    <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Accent picker popup -->
        <Popup x:Name="AccentPopup" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False" StaysOpen="False" Placement="Relative">
            <Border CornerRadius="12" Background="#F0141414" BorderBrush="{StaticResource Orb.SeparatorBrush}" BorderThickness="1" Padding="12" Width="220">
                <StackPanel>
                    <TextBlock Text="Accent color" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button Width="36" Height="36" Margin="4" Background="#5865F2" BorderThickness="2" BorderBrush="#5865F2" Cursor="Hand" Tag="#5865F2" Click="AccentColor_Click" ToolTip="Blurple (default)"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="18" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/></ControlTemplate></Button.Template></Button>
                        <Button Width="36" Height="36" Margin="4" Background="#ED4245" BorderThickness="0" Cursor="Hand" Tag="#ED4245" Click="AccentColor_Click" ToolTip="Red"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="18"/></ControlTemplate></Button.Template></Button>
                        <Button Width="36" Height="36" Margin="4" Background="#57F287" BorderThickness="0" Cursor="Hand" Tag="#57F287" Click="AccentColor_Click" ToolTip="Green"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="18"/></ControlTemplate></Button.Template></Button>
                        <Button Width="36" Height="36" Margin="4" Background="#FEE75C" BorderThickness="0" Cursor="Hand" Tag="#FEE75C" Click="AccentColor_Click" ToolTip="Yellow"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="18"/></ControlTemplate></Button.Template></Button>
                        <Button Width="36" Height="36" Margin="4" Background="#EB459E" BorderThickness="0" Cursor="Hand" Tag="#EB459E" Click="AccentColor_Click" ToolTip="Pink"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="18"/></ControlTemplate></Button.Template></Button>
                        <Button Width="36" Height="36" Margin="4" Background="#00D1FF" BorderThickness="0" Cursor="Hand" Tag="#00D1FF" Click="AccentColor_Click" ToolTip="Cyan"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="18"/></ControlTemplate></Button.Template></Button>
                        <Button Width="36" Height="36" Margin="4" Background="#FF73FA" BorderThickness="0" Cursor="Hand" Tag="#FF73FA" Click="AccentColor_Click" ToolTip="Magenta"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="18"/></ControlTemplate></Button.Template></Button>
                        <Button Width="36" Height="36" Margin="4" Background="#FFA500" BorderThickness="0" Cursor="Hand" Tag="#FFA500" Click="AccentColor_Click" ToolTip="Orange"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="18"/></ControlTemplate></Button.Template></Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Free games popup -->
        <Popup x:Name="NotificationsPopup" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False" StaysOpen="False" Placement="Relative" Closed="NotificationsPopup_Closed">
            <Border CornerRadius="12" Background="#F0141414" BorderBrush="{StaticResource Orb.SeparatorBrush}" BorderThickness="1" Width="360" MaxHeight="480">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="14,12" CornerRadius="12,12,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Alert24" FontSize="16" Foreground="White" Margin="0,0,8,0"/>
                                <TextBlock Text="Free games" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                <Border Background="#33FFFFFF" CornerRadius="8" Padding="6,2" Margin="10,0,0,0" Visibility="{Binding FreeGames.HasUnseen, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding FreeGames.UnseenCount}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnMarkAllSeen_Click" ToolTip="Mark all as seen" Margin="0,0,4,0">
                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="White"/>
                                </Button>
                                <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClosePopup_Click" ToolTip="Close">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8,8,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding FreeGames.Games}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="56" Height="56" CornerRadius="8" Margin="0,0,10,0"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="6,1"><TextBlock Text="{Binding PlatformLabel}" FontSize="10" Foreground="White"/></Border>
                                                        <TextBlock Text="{Binding Worth}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" TextDecorations="Strikethrough"/>
                                                        <TextBlock Text="$0" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Background="{DynamicResource Orb.SystemAccentBrush}" Foreground="White" BorderThickness="0" Padding="10,6" Cursor="Hand" VerticalAlignment="Center"
                                                        Tag="{Binding}" ToolTip="Open giveaway" Click="ClaimButton_Click">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Claim" FontSize="11" VerticalAlignment="Center" Foreground="White"/><ui:SymbolIcon Symbol="Open24" FontSize="12" Margin="4,0,0,0" Foreground="White"/></StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No free games right now. Check back soon!" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Padding="0,20,0,16"
                                       Visibility="{Binding FreeGames.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Padding="8" BorderBrush="{StaticResource Orb.SeparatorBrush}" BorderThickness="0,1,0,0">
                        <Button HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand" Command="{Binding FreeGames.RefreshCommand}">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowSync24" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Refresh" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Popup>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Width="220" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,16">
                    <TextBlock Text="M  O  D  E  S" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,12" FontFamily="{StaticResource BodyFont}"
                               Visibility="{Binding SidebarCollapsed, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                    <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" FontSize="13" Margin="0,0,0,6" Command="{Binding NavigateCommand}" CommandParameter="Quests">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Background" Value="Transparent"/><Setter Property="Appearance" Value="Secondary"/>
                                <Style.Triggers><DataTrigger Binding="{Binding CurrentView}" Value="Quests"><Setter Property="Background" Value="{StaticResource CardBrush}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Trophy24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Active Quests" VerticalAlignment="Center" Visibility="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/></StackPanel>
                    </ui:Button>
                    <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" FontSize="13" Margin="0,0,0,6" Command="{Binding NavigateCommand}" CommandParameter="UnifiedSearch">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Background" Value="Transparent"/><Setter Property="Appearance" Value="Secondary"/>
                                <Style.Triggers><DataTrigger Binding="{Binding CurrentView}" Value="UnifiedSearch"><Setter Property="Background" Value="{StaticResource CardBrush}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Search24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Search" VerticalAlignment="Center" Visibility="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/></StackPanel>
                    </ui:Button>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,10,0,8" Cursor="Hand" MouseLeftButtonDown="AdvancedToggle_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="▸  Advanced"/>
                                <Setter Property="Visibility" Value="{Binding SidebarCollapsed, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdvancedExpanded}" Value="True"><Setter Property="Text" Value="▾  Advanced"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Visibility="{Binding IsAdvancedExpanded, Converter={StaticResource BoolToVisibilityConverter}}" Margin="8,0,0,0">
                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding SidebarCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" FontSize="13" Margin="0,0,0,6" Command="{Binding NavigateCommand}" CommandParameter="Database">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Database24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Discord Database" VerticalAlignment="Center"/></StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" FontSize="13" Margin="0,0,0,6" Command="{Binding NavigateCommand}" CommandParameter="Steam">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Games24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Steam Quest" VerticalAlignment="Center"/></StackPanel>
                        </ui:Button>
                        <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" FontSize="13" Margin="0,0,0,6" Command="{Binding NavigateCommand}" CommandParameter="Manual">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Wrench24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Manual Mode" VerticalAlignment="Center"/></StackPanel>
                        </ui:Button>
                    </StackPanel>
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,12,0,12"/>
                    <TextBlock Text="I  N  F  O" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,12" FontFamily="{StaticResource BodyFont}"
                               Visibility="{Binding SidebarCollapsed, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                    <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" FontSize="13" Margin="0,0,0,6" Command="{Binding NavigateCommand}" CommandParameter="Credits">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Info24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Credits &amp; Info" VerticalAlignment="Center" Visibility="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/></StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" FontSize="13" Margin="0,0,0,6" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="{StaticResource WarningBrush}" Click="UpdateReminder_Click">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowUp24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Update Available" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,12,0,12"/>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Column="1" Margin="28,24">
                <!-- Loading -->
                <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Loading}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Quests -->
                <views:QuestsView DataContext="{Binding Quests}" Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Quests}"/>
                <!-- Search -->
                <views:UnifiedSearchView DataContext="{Binding UnifiedSearch}" Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=UnifiedSearch}"/>
                <!-- Database -->
                <views:DatabaseView DataContext="{Binding Database}" Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Database}"/>
                <!-- Steam -->
                <views:SteamView DataContext="{Binding Steam}" Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Steam}"/>
                <!-- Manual -->
                <views:ManualView DataContext="{Binding Manual}" Visibility="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Manual}"/>
                <!-- Credits -->
                <views:CreditsView Visibility="{Binding CurrentView, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Credits}"/>
            </Grid>
        </Grid>

        <!-- Dialog Host for ContentDialogService (WPF-UI) -->
        <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="4" Panel.ZIndex="1000" />

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GameCountText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <ui:SymbolIcon Symbol="Heart24" FontSize="16" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="14,0,0,0" Cursor="Hand" ToolTip="Enjoying OrbSpoofer? Buy me a coffee!" MouseLeftButtonDown="Kofi_HeartClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
