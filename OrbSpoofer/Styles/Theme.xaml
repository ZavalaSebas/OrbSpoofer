<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- OrbSpoofer Fluent Theme — V2 Aurora. Dark, vivid but serious. -->
    <Color x:Key="Orb.Accent.Primary.Color">#5865F2</Color>
    <Color x:Key="Orb.Accent.Secondary.Color">#7B83FF</Color>
    <Color x:Key="Orb.Accent.Tertiary.Color">#3A44D0</Color>
    <Color x:Key="SystemAccentColorPrimary">#5865F2</Color>
    <Color x:Key="SystemAccentColorSecondary">#7B83FF</Color>
    <Color x:Key="SystemAccentColorTertiary">#3A44D0</Color>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource SystemAccentColorSecondary}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource SystemAccentColorTertiary}" />
    <SolidColorBrush x:Key="Orb.SystemAccentBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <!-- Gradient brushes — subtle, no neon -->
    <LinearGradientBrush x:Key="Orb.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5865F2" Offset="0"/>
        <GradientStop Color="#7B83FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Orb.Accent.GradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6A75F5" Offset="0"/>
        <GradientStop Color="#8E96FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Orb.Play.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#57F287" Offset="0"/>
        <GradientStop Color="#3DD67A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Orb.PlayBrush" Color="#57F287" />
    <SolidColorBrush x:Key="Orb.StopBrush" Color="#ED4245" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource SystemAccentColorPrimary}" />

    <Color x:Key="Orb.Background.Primary.Color">#08080A</Color>
    <Color x:Key="Orb.Background.Secondary.Color">#0F0F11</Color>
    <Color x:Key="Orb.Background.Tertiary.Color">#18181C</Color>
    <Color x:Key="Orb.Background.Quaternary.Color">#1E1E22</Color>
    <Color x:Key="Orb.Text.Primary.Color">#EDEDF0</Color>
    <Color x:Key="Orb.Text.Secondary.Color">#9A9AA0</Color>
    <Color x:Key="Orb.Text.Muted.Color">#5E5E66</Color>

    <Color x:Key="ApplicationBackgroundColor">#08080A</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Orb.Background.Primary.Color}" />
    <Color x:Key="SolidBackgroundFillColorBase">#08080A</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource Orb.Background.Primary.Color}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource Orb.Background.Secondary.Color}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource Orb.Background.Tertiary.Color}" />

    <Color x:Key="TextFillColorPrimary">#EDEDF0</Color>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Orb.Text.Primary.Color}" />
    <Color x:Key="TextFillColorSecondary">#9A9AA0</Color>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Orb.Text.Secondary.Color}" />
    <Color x:Key="TextFillColorTertiary">#5E5E66</Color>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Orb.Text.Muted.Color}" />

    <Color x:Key="ControlFillColorDefault">#18181C</Color>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Orb.Background.Tertiary.Color}" />
    <Color x:Key="ControlStrokeColorDefault">#222228</Color>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#222228" />

    <FontFamily x:Key="Orb.FontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <sys:Double x:Key="Orb.FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="Orb.FontSize.Body">13</sys:Double>
    <sys:Double x:Key="Orb.FontSize.Title">20</sys:Double>
    <sys:Double x:Key="Orb.FontSize.Display">28</sys:Double>

    <Thickness x:Key="Orb.Spacing.XS">4</Thickness>
    <Thickness x:Key="Orb.Spacing.SM">8</Thickness>
    <Thickness x:Key="Orb.Spacing.MD">12</Thickness>
    <Thickness x:Key="Orb.Spacing.LG">16</Thickness>
    <CornerRadius x:Key="Orb.CornerRadius.Card">12</CornerRadius>
    <CornerRadius x:Key="Orb.CornerRadius.Control">8</CornerRadius>

    <!-- Motion — professional, smooth -->
    <Duration x:Key="Orb.Motion.Fast">0:0:0.18</Duration>
    <Duration x:Key="Orb.Motion.Normal">0:0:0.28</Duration>
    <Duration x:Key="Orb.Motion.Slow">0:0:0.40</Duration>
    <Duration x:Key="Orb.Motion.ExtraSlow">0:0:0.55</Duration>
    <CubicEase x:Key="Orb.Ease.OutCubic" EasingMode="EaseOut"/>
    <CubicEase x:Key="Orb.Ease.InOutCubic" EasingMode="EaseInOut"/>
    <KeySpline x:Key="Orb.Easing.EaseOut">0.22,1,0.36,1</KeySpline>
    <KeySpline x:Key="Orb.Easing.Emphasized">0.2,0,0,1</KeySpline>
    <KeySpline x:Key="Orb.Easing.Standard">0.4,0,0.2,1</KeySpline>

    <!-- Brushes base -->
    <SolidColorBrush x:Key="Orb.Sidebar.Background" Color="{StaticResource Orb.Background.Secondary.Color}" />
    <SolidColorBrush x:Key="Orb.Card.Background" Color="#0F0F11" />
    <SolidColorBrush x:Key="Orb.Card.Hover" Color="#18181C" />
    <SolidColorBrush x:Key="Orb.SeparatorBrush" Color="#1E1E22" />
    <SolidColorBrush x:Key="Orb.SeparatorSubtleBrush" Color="#16161A" />
    <!-- Glass / glow -->
    <SolidColorBrush x:Key="Orb.Glow.Accent" Color="#5865F2" Opacity="0.08"/>
    <RadialGradientBrush x:Key="Orb.Glow.Radial" GradientOrigin="0.5,0.15" Center="0.5,0.15" RadiusX="0.9" RadiusY="0.7">
        <GradientStop Color="#185865F2" Offset="0"/>
        <GradientStop Color="#005865F2" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="Orb.Header.Gradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F0F11" Offset="0"/>
        <GradientStop Color="#0A0A0C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Orb.Sidebar.Gradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0F0F11" Offset="0"/>
        <GradientStop Color="#0C0C0E" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== Cards ===== -->
    <Style x:Key="Orb.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Orb.Card.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource Orb.SeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Orb.CornerRadius.Card}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.18" Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Animated card — hover lift + accent border + shadow (no overflow) -->
    <Style x:Key="Orb.CardHover" TargetType="Border" BasedOn="{StaticResource Orb.Card}">
        <Setter Property="Panel.ZIndex" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Panel.ZIndex" Value="10"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#2A2E6A" Duration="{StaticResource Orb.Motion.Fast}"/>
                            <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#18181C" Duration="{StaticResource Orb.Motion.Fast}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.006" Duration="{StaticResource Orb.Motion.Fast}">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.006" Duration="{StaticResource Orb.Motion.Fast}">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-2" Duration="{StaticResource Orb.Motion.Fast}">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#1E1E22" Duration="{StaticResource Orb.Motion.Fast}"/>
                            <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#0F0F11" Duration="{StaticResource Orb.Motion.Fast}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Orb.Motion.Fast}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Orb.Motion.Fast}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="{StaticResource Orb.Motion.Fast}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Card con entrada animada (para stagger via Loaded) -->
    <Style x:Key="Orb.CardAnimated" TargetType="Border" BasedOn="{StaticResource Orb.CardHover}">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                    <TranslateTransform X="0" Y="8"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.98" To="1" Duration="0:0:0.35">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.98" To="1" Duration="0:0:0.35">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="8" To="0" Duration="0:0:0.40">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- View host — fade + slide -->
    <Style x:Key="Orb.ViewHost" TargetType="Grid">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="0" Y="12"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Visibility" Value="Visible">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(Grid.RenderTransform).(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.38">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar button — accent slide indicator -->
    <Style x:Key="Orb.SidebarButton" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#18181C"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Play button press -->
    <Style x:Key="Orb.PlayButton" TargetType="Border">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.14"/>
                        <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.14"/>
                    </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14"/>
                        <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14"/>
                    </Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ContextMenu polish — more compact, less plastic -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="#E01A1A1E" />
        <Setter Property="BorderBrush" Value="#401A1A1E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.45" Color="#000000"/></Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"/>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="6,0,12,0"/>
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Right" AllowsTransparency="True" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade">
                            <Border Background="#E01A1A1E" BorderBrush="#401A1A1E" BorderThickness="1" CornerRadius="12" Padding="6"><ItemsPresenter/></Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#232326"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
