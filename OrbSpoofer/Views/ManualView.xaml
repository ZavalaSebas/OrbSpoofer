<UserControl x:Class="OrbSpoofer.Views.ManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="9" VerticalAlignment="Center" Margin="0,0,12,0" Background="{DynamicResource Orb.Tint.WarningBg}" BorderBrush="{DynamicResource Orb.Tint.WarningBorder}" BorderThickness="1">
                <ui:SymbolIcon Symbol="Wrench24" FontSize="18" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Manual Mode" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="Enter the exact process name Discord expects" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Orb.Card}" Margin="0,14,0,0" Padding="16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:SymbolIcon Symbol="Lightbulb24" FontSize="14" Foreground="{DynamicResource WarningBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Examples" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Background="{DynamicResource Orb.ElevatedBrush}" CornerRadius="8" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6">
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="TslGame.exe — PUBG"/>
                </Border>
                <Border Background="{DynamicResource Orb.ElevatedBrush}" CornerRadius="8" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6">
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="League of Legends.exe — LoL"/>
                </Border>
                <Border Background="{DynamicResource Orb.ElevatedBrush}" CornerRadius="8" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="Overwatch.exe"/>
                </Border>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Margin="0,12,0,0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="Document24" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,6,0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalContentAlignment="Center" Padding="0,10"
                         Text="{Binding ExeName, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            <TextBlock Text="e.g. TslGame.exe" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" x:Name="Ph"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Text" Value=""><Setter TargetName="Ph" Property="Visibility" Value="Visible"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Grid.Column="2" Command="{Binding SpoofCommand}" ToolTip="Spoof" Cursor="Hand" Width="42" Height="42" BorderThickness="0" Background="Transparent" Padding="0" Margin="4,2,2,2">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="10" Width="42" Height="42">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource SystemAccentColorPrimary}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource SystemAccentColorSecondary}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.28" Color="{DynamicResource SystemAccentColorPrimary}"/></Border.Effect>
                                <ui:SymbolIcon Symbol="Play24" Filled="True" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.92"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
        <Border Grid.Row="3" Margin="0,12,0,0" Background="{DynamicResource Orb.Tint.SuccessBg}" CornerRadius="10" Padding="14" BorderBrush="{DynamicResource Orb.Tint.SuccessBorder}" BorderThickness="1"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="8" Background="#1E3A28" Margin="0,0,10,0">
                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="#57F287" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ResultText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
