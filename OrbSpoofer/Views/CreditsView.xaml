<UserControl x:Class="OrbSpoofer.Views.CreditsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Margin="4,4,12,6">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="11" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource SystemAccentColorPrimary}" Offset="0"/>
                            <GradientStop Color="#EB459E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ui:SymbolIcon Symbol="Info24" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Credits &amp; Info" Style="{StaticResource Orb.SectionHeading}" FontSize="25"/>
                    <TextBlock Text="About the project and how it works" Style="{StaticResource Orb.Caption}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Orb.CardHover}" Padding="22" Margin="4,2,4,14" ClipToBounds="False">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Orb.ElevatedBrush}" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Book24" FontSize="16" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="About" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="22">
                        OrbSpoofer is a game process spoofer that tricks Discord into thinking you're running a game by creating fake processes with the exact names Discord expects. No client modification. No code injection.
                    </TextBlock>
                    <Border Background="{DynamicResource Orb.ElevatedBrush}" CornerRadius="8" Padding="12,8" Margin="0,14,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock><Hyperlink NavigateUri="https://github.com/ZavalaSebas/OrbSpoofer" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" TextDecorations="None">View on GitHub — ZavalaSebas/OrbSpoofer →</Hyperlink></TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Orb.CardHover}" Padding="22" Margin="4,2,4,14" ClipToBounds="False">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Orb.Tint.SuccessBg}" BorderBrush="{DynamicResource Orb.Tint.SuccessBorder}" BorderThickness="1" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="How it works" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel>
                        <Border Background="{DynamicResource Orb.ElevatedBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal"><Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource BorderBrush}" Margin="0,0,10,0"><TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Your active Discord quests appear automatically on launch" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/></StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Orb.ElevatedBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal"><Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource BorderBrush}" Margin="0,0,10,0"><TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Double-click a quest or press ▶ to start spoofing" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/></StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Orb.ElevatedBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal"><Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource BorderBrush}" Margin="0,0,10,0"><TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="OrbSpoofer creates a fake process with the exact name Discord expects" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/></StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Orb.ElevatedBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal"><Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Orb.Tint.SuccessBg}" BorderBrush="{DynamicResource Orb.Tint.SuccessBorder}" BorderThickness="1" Margin="0,0,10,0"><TextBlock Text="4" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Discord detects it and thinks you're playing the game" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/></StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="22" Margin="4,2,4,14" CornerRadius="12" BorderThickness="1" Background="{DynamicResource Orb.Tint.DangerBg}" BorderBrush="{DynamicResource Orb.Tint.DangerBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Orb.Tint.DangerBg}" BorderBrush="{DynamicResource Orb.Tint.DangerBorder}" BorderThickness="1" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Heart24" FontSize="16" Foreground="#ED4245" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Support" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20" Margin="0,0,0,16">Enjoying OrbSpoofer? Your support keeps the project alive and evolving.</TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Cursor="Hand" Padding="16,9" BorderThickness="0" Click="Kofi_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="9" Padding="{TemplateBinding Padding}" Background="#ED4245">
                                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.30" Color="#ED4245"/></Border.Effect>
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Heart24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/><TextBlock Text="Buy me a coffee" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" FontSize="12"/></StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Cursor="Hand" Padding="16,9" BorderThickness="0" Margin="12,0,0,0" Click="Sponsor_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="9" Padding="{TemplateBinding Padding}" Background="{DynamicResource Orb.ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Heart24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#ED4245"/><TextBlock Text="GitHub Sponsor" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/></StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Cursor="Hand" Padding="16,9" BorderThickness="0" Margin="12,0,0,0" Click="Share_Click" ToolTip="Copy latest release link">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="9" Padding="{TemplateBinding Padding}" Background="{DynamicResource Orb.ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Share24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"/><TextBlock Text="Share" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/></StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Hall of Fame — Special Thanks (tint follows the theme; hover lift only, colors stay) -->
            <Border Padding="22" Margin="4,2,4,14" ClipToBounds="False" CornerRadius="12" BorderThickness="1" Background="{DynamicResource Orb.Tint.WarningBg}" BorderBrush="{DynamicResource Orb.Tint.WarningBorder}" Style="{StaticResource Orb.CardHover}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Orb.Tint.WarningBg}" BorderBrush="{DynamicResource Orb.Tint.WarningBorder}" BorderThickness="1" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Trophy24" FontSize="16" Foreground="#FDB813" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"><Run Text="Special Thanks"/><Run Text="  ·  Hall of Fame" Foreground="#FDB813" FontSize="12" FontWeight="Normal"/></TextBlock>
                            <TextBlock Text="Thanks to everyone who buys a coffee ☕" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18" Margin="0,8,0,14" Opacity="0.9">Every coffee keeps OrbSpoofer alive. Huge thanks to everyone that support the project, makes me extremely happy :)</TextBlock>

                    <!-- Supporter #1 — Trang — clickable to Ko-fi transaction -->
                    <Border Background="{DynamicResource Orb.ElevatedBrush}" CornerRadius="10" Padding="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12" Cursor="Hand" ToolTip="View coffee on Ko-fi" MouseLeftButtonDown="Trang_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FDB813" Offset="0"/>
                                        <GradientStop Color="#FF8A00" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="T" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Trang" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource Orb.Tint.WarningBg}" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" BorderBrush="{DynamicResource Orb.Tint.WarningBorder}" BorderThickness="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="☕" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="First Supporter" FontSize="10" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ui:SymbolIcon Symbol="Open24" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.7"/>
                                </StackPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"><Run Text="First person to buy a coffee"/><Run Text=" · Sep 2026" Foreground="{DynamicResource TextMutedBrush}"/></TextBlock>
                                <TextBlock Text="“infinite thanks! :D I will always remember you for being my first ever coffee :)”" FontSize="11" Foreground="{DynamicResource WarningBrush}" FontStyle="Italic" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.9"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#FDB813" CornerRadius="7" Padding="8,5" VerticalAlignment="Center" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="🥇" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBlock Text="#1" FontSize="11" FontWeight="Bold" Foreground="#1A1200" VerticalAlignment="Center"/></StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CTA — want to appear here? -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="Kofi_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Heart24" FontSize="12" Foreground="#ED4245" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"><Run Text="Want to appear here?"/><Run Text="  Buy a coffee →" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" FontWeight="SemiBold"/></TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="ko-fi.com/sebastianzavala82573" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,4">
                <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"><Run Text="Original concept by "/></TextBlock>
                <TextBlock FontSize="12" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" Cursor="Hand" MouseLeftButtonDown="Strykey_Click" Text="Strykey"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Text=" · "/>
                <TextBlock FontSize="12" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" Cursor="Hand" MouseLeftButtonDown="Orbshacker_Click" Text="orbshacker"/>
            </StackPanel>
            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="GitHubProfile_Click"><Run Text="Made with love by "/><Run Text="ZavalaSebas" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"/></TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
