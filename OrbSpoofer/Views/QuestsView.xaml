<UserControl x:Class="OrbSpoofer.Views.QuestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Live header -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="9" VerticalAlignment="Center" Margin="0,0,12,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource SystemAccentColorPrimary}" Offset="0"/>
                        <GradientStop Color="{DynamicResource SystemAccentColorSecondary}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <ui:SymbolIcon Symbol="Trophy24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Active Quests" Style="{StaticResource Orb.SectionHeading}" FontSize="25"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button Appearance="Secondary" Padding="14,7" FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                           Command="{Binding ClaimCommand}"
                           ToolTip="{Binding ClaimTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Open24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ClaimText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Appearance="Secondary" Padding="14,7" FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                           Visibility="{Binding CanAutoVideos, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding AutoAllVideosCommand}"
                           ToolTip="Enroll + auto-watch every video quest (needs token)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Video24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AutoVideosText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button HorizontalAlignment="Right" Appearance="Primary" Background="{DynamicResource Orb.SystemAccentBrush}" Foreground="White" BorderBrush="{DynamicResource Orb.SystemAccentBrush}" Padding="14,7" FontSize="12" Cursor="Hand" VerticalAlignment="Center"
                           Visibility="{Binding CanRunAll, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding RunAllCommand}">
                    <ui:Button.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28" Color="{DynamicResource SystemAccentColorPrimary}"/></ui:Button.Effect>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="{Binding RunAllText}" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Mission radar + filters: single compact strip, counters live inside the chips -->
        <Grid Grid.Row="1" Margin="0,10,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,12,0" ToolTip="Live quest count — follows region and type filters">
                <TextBlock Text="{Binding VisibleQuestCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource Orb.DisplayFont}" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="RADAR" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"/>
                    <TextBlock Text="active" Style="{StaticResource Orb.Caption}" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Margin="0,0,6,0" Cursor="Hand" Padding="12,6" FontSize="11" FontWeight="SemiBold" BorderThickness="1"
                        Command="{Binding DataContext.SetQuestFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="All">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="All "/>
                            <TextBlock Text="{Binding DataContext.VisibleQuestCount, RelativeSource={RelativeSource AncestorType=UserControl}}" Opacity="0.65"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource Orb.ElevatedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.QuestTypeFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="All">
                                    <Setter Property="Background" Value="{DynamicResource Orb.SystemAccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Orb.SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="0,0,6,0" Cursor="Hand" Padding="12,6" FontSize="11" FontWeight="SemiBold" BorderThickness="1"
                        Command="{Binding DataContext.SetQuestFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Play">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮 Play "/>
                            <TextBlock Text="{Binding DataContext.PlayCount, RelativeSource={RelativeSource AncestorType=UserControl}}" Opacity="0.65"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource Orb.ElevatedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.QuestTypeFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Play">
                                    <Setter Property="Background" Value="{DynamicResource Orb.SystemAccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Orb.SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="0,0,6,0" Cursor="Hand" Padding="12,6" FontSize="11" FontWeight="SemiBold" BorderThickness="1"
                        Command="{Binding DataContext.SetQuestFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Video">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📺 Video "/>
                            <TextBlock Text="{Binding DataContext.VideoQuestCount, RelativeSource={RelativeSource AncestorType=UserControl}}" Opacity="0.65"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource Orb.ElevatedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.QuestTypeFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Video">
                                    <Setter Property="Background" Value="{DynamicResource Orb.SystemAccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Orb.SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="0,0,6,0" Cursor="Hand" Padding="12,6" FontSize="11" FontWeight="SemiBold" BorderThickness="1"
                        Command="{Binding DataContext.SetQuestFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Stream">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📡 Stream "/>
                            <TextBlock Text="{Binding DataContext.StreamCount, RelativeSource={RelativeSource AncestorType=UserControl}}" Opacity="0.65"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource Orb.ElevatedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.QuestTypeFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Stream">
                                    <Setter Property="Background" Value="{DynamicResource Orb.SystemAccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Orb.SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="0,0,6,0" Cursor="Hand" Padding="12,6" FontSize="11" FontWeight="SemiBold" BorderThickness="1"
                        Command="{Binding DataContext.SetQuestFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Other">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▫ Other "/>
                            <TextBlock Text="{Binding DataContext.OtherCount, RelativeSource={RelativeSource AncestorType=UserControl}}" Opacity="0.65"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource Orb.ElevatedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.QuestTypeFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Other">
                                    <Setter Property="Background" Value="{DynamicResource Orb.SystemAccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Orb.SystemAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Border Width="28" Height="28" CornerRadius="14" Margin="6,0,0,0" Background="{DynamicResource Orb.ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        ToolTip="Video quests can't be spoofed — open them in Discord (↗ button or Claim link). Region badges show availability. Hidden quests stay out of Run All."
                        Cursor="Help" VerticalAlignment="Center">
                    <TextBlock Text="ⓘ" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <!-- List always visible; IsLoading only lowers opacity (no Collapse -> no black flash) -->
                <ListBox x:Name="QuestsList" Padding="4,4,8,6" ClipToBounds="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding QuestsView}" VirtualizingPanel.IsVirtualizing="False" ScrollViewer.CanContentScroll="False" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,12,12,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ItemCount, StringFormat=({0})}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <Border Grid.Column="2" Height="1" Background="{DynamicResource Orb.SeparatorBrush}" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7"/>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Visibility" Value="{Binding HasNoQuests, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Opacity" Value="0.45"/><Setter Property="IsHitTestVisible" Value="False"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1,0,1"/>
                        <Setter Property="ClipToBounds" Value="False"/>
                        <Setter Property="Panel.ZIndex" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="border" Background="Transparent" Padding="0" ClipToBounds="False"><ContentPresenter/></Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Panel.ZIndex" Value="10"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4,2,12,6" ClipToBounds="False" ToolTip="Double-click: spoof play quests, open video quests in Discord">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Orb.CardHover}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.48" Duration="0:0:0.32">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.26">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <!-- Dark tile bg (art transparency is tuned for dark); theme-aware border so no black frame in light -->
                                <Border Grid.Column="0" Width="54" Height="54" CornerRadius="11" Background="#0A0A0C" Margin="0,0,14,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <!-- Rounded clip (Border.ClipToBounds ignores CornerRadius — square image corners would bleed through) -->
                                    <Image Source="{Binding ImageUrl}" Width="54" Height="54" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Clip><RectangleGeometry Rect="0,0,54,54" RadiusX="11" RadiusY="11"/></Image.Clip>
                                    </Image>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GameName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding QuestName}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Background="{DynamicResource Orb.Tint.SuccessBg}" CornerRadius="6" Padding="7,3" BorderBrush="{DynamicResource Orb.Tint.SuccessBorder}" BorderThickness="1">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"><Run Text="{Binding Reward, Mode=OneWay}"/></TextBlock>
                                        </Border>
                                        <Border Background="{DynamicResource Orb.ElevatedBrush}" CornerRadius="6" Padding="6,3" Margin="6,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding TaskDurationLabel, Mode=OneWay}"/>
                                        </Border>
                                        <Border Background="{DynamicResource Orb.Tint.WarningBg}" CornerRadius="6" Padding="6,3" Margin="6,0,0,0" BorderBrush="{DynamicResource Orb.Tint.WarningBorder}" BorderThickness="1">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource WarningBrush}"><Run Text="Ends "/><Run Text="{Binding ExpiresAt, Mode=OneWay, StringFormat={}{0:MMM d}}"/></TextBlock>
                                        </Border>
                                        <Border Background="{DynamicResource Orb.Tint.InfoBg}" CornerRadius="6" Padding="6,3" Margin="6,0,0,0" BorderBrush="{DynamicResource Orb.Tint.InfoBorder}" BorderThickness="1" ToolTip="Quest type">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" FontWeight="SemiBold" Text="{Binding TaskLabel, Mode=OneWay}"/>
                                        </Border>
                                        <Button Margin="6,0,0,0" Cursor="Hand" Padding="0" BorderThickness="0" Background="Transparent"
                                                Command="{Binding DataContext.AutoVideoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                ToolTip="Auto enroll + watch (needs token)">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AutoAvailable}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="6" Padding="7,3" Background="{DynamicResource Orb.SystemAccentBrush}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Text="{Binding AutoButtonText, Mode=OneWay}"/>
                                                            <TextBlock FontSize="11" Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0" Opacity="0.85" Text="{Binding AutoProgressText, Mode=OneWay}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAutomating}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Border CornerRadius="6" Padding="6,3" Margin="6,0,0,0" BorderThickness="1" ToolTip="Region availability" Background="{DynamicResource Orb.Tint.SuccessBg}" BorderBrush="{DynamicResource Orb.Tint.SuccessBorder}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RegionKind}" Value="Include">
                                                            <Setter Property="Background" Value="{DynamicResource Orb.Tint.WarningBg}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Orb.Tint.WarningBorder}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RegionKind}" Value="Exclude">
                                                            <Setter Property="Background" Value="{DynamicResource Orb.Tint.DangerBg}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Orb.Tint.DangerBorder}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding RegionText, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RegionKind}" Value="Include">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RegionKind}" Value="Exclude">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="{DynamicResource Orb.Tint.DangerBg}" CornerRadius="6" Padding="6,3" Margin="6,0,0,0" BorderBrush="{DynamicResource Orb.Tint.DangerBorder}" BorderThickness="1">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NeedsSteamMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource ErrorBrush}" Text="⚠ Steam required"/>
                                        </Border>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" Cursor="Hand" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Text="Claim in Discord ↗"
                                                   ToolTip="Open Discord quest home to accept &amp; claim">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSpoofable}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenQuestHomeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="3" Width="30" Height="30" CornerRadius="15" Cursor="Hand" Tag="{Binding}" ToolTip="Toggle completed" BorderThickness="1.5" Background="{DynamicResource Orb.ElevatedBrush}" BorderBrush="{DynamicResource Orb.SystemAccentBrush}" VerticalAlignment="Center" PreviewMouseLeftButtonDown="ToggleCompleted_Click">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Background" Value="#57F287"/><Setter Property="BorderBrush" Value="#57F287"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" Command="{Binding DataContext.SpoofCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand" Padding="0" Width="44" Height="44" BorderThickness="0" Background="Transparent">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="ToolTip" Value="Spoof"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSpoofable}" Value="False">
                                                    <Setter Property="ToolTip" Value="Open in Discord to watch"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" CornerRadius="11" Width="44" Height="44">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{DynamicResource SystemAccentColorPrimary}" Offset="0"/>
                                                        <GradientStop Color="{DynamicResource SystemAccentColorSecondary}" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.30" Color="{DynamicResource SystemAccentColorPrimary}"/></Border.Effect>
                                                <ui:SymbolIcon Filled="True" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Play24">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSpoofable}" Value="False">
                                                                    <Setter Property="Symbol" Value="Open24"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Effect">
                                                        <Setter.Value><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.40" Color="{DynamicResource SystemAccentColorPrimary}"/></Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.85"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- Centered overlay: spinner over dimmed list, without hiding list -->
            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" IsHitTestVisible="True" Background="#00000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <!-- Empty state on top -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoQuests, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Orb.ElevatedBrush}" HorizontalAlignment="Center" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ui:SymbolIcon Symbol="Trophy24" FontSize="28" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding EmptyText}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
