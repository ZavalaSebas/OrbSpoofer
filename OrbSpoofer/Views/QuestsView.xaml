<UserControl x:Class="OrbSpoofer.Views.QuestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Live header -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="9" VerticalAlignment="Center" Margin="0,0,12,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource SystemAccentColorPrimary}" Offset="0"/>
                        <GradientStop Color="{DynamicResource SystemAccentColorSecondary}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <ui:SymbolIcon Symbol="Trophy24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Active Quests" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Play, stream &amp; video quests — ▶ spoofs, 📺 opens Discord" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <ui:Button Grid.Column="2" HorizontalAlignment="Right" Appearance="Primary" Background="{DynamicResource Orb.SystemAccentBrush}" Foreground="White" BorderBrush="{DynamicResource Orb.SystemAccentBrush}" Padding="14,7" FontSize="12" Cursor="Hand" VerticalAlignment="Center"
                       Visibility="{Binding CanRunAll, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding RunAllCommand}">
                <ui:Button.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28" Color="{DynamicResource SystemAccentColorPrimary}"/></ui:Button.Effect>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                    <TextBlock Text="{Binding RunAllText}" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
            </ui:Button>
        </Grid>

        <Border Grid.Row="1" Margin="0,8,0,14" Background="{DynamicResource Orb.ElevatedBrush}" CornerRadius="10" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Orb.ElevatedBrush}" Margin="0,0,10,0">
                    <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="Video quests can't be spoofed — hit 📺 to open them in Discord. Region badges show availability." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <!-- List always visible; IsLoading only lowers opacity (no Collapse -> no black flash) -->
            <ListBox x:Name="QuestsList" Padding="4,4,8,6" ClipToBounds="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding QuestsView}" VirtualizingPanel.IsVirtualizing="False" ScrollViewer.CanContentScroll="False" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Visibility" Value="{Binding HasNoQuests, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Opacity" Value="0.45"/><Setter Property="IsHitTestVisible" Value="False"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1,0,1"/>
                        <Setter Property="ClipToBounds" Value="False"/>
                        <Setter Property="Panel.ZIndex" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="border" Background="Transparent" Padding="0" ClipToBounds="False"><ContentPresenter/></Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Panel.ZIndex" Value="10"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4,2,12,6" ClipToBounds="False" ToolTip="Double-click: spoof play quests, open video quests in Discord">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Orb.CardHover}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.48" Duration="0:0:0.32">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.26">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <!-- Dark tile bg (art transparency is tuned for dark); theme-aware border so no black frame in light -->
                                <Border Grid.Column="0" Width="54" Height="54" CornerRadius="11" Background="#0A0A0C" Margin="0,0,14,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <!-- Rounded clip (Border.ClipToBounds ignores CornerRadius — square image corners would bleed through) -->
                                    <Image Source="{Binding ImageUrl}" Width="54" Height="54" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Clip><RectangleGeometry Rect="0,0,54,54" RadiusX="11" RadiusY="11"/></Image.Clip>
                                    </Image>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GameName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding QuestName}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Background="{DynamicResource Orb.Tint.SuccessBg}" CornerRadius="6" Padding="7,3" BorderBrush="{DynamicResource Orb.Tint.SuccessBorder}" BorderThickness="1">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"><Run Text="{Binding Reward, Mode=OneWay}"/></TextBlock>
                                        </Border>
                                        <Border Background="{DynamicResource Orb.ElevatedBrush}" CornerRadius="6" Padding="6,3" Margin="6,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding TaskDurationLabel, Mode=OneWay}"/>
                                        </Border>
                                        <Border Background="{DynamicResource Orb.Tint.WarningBg}" CornerRadius="6" Padding="6,3" Margin="6,0,0,0" BorderBrush="{DynamicResource Orb.Tint.WarningBorder}" BorderThickness="1">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource WarningBrush}"><Run Text="Ends "/><Run Text="{Binding ExpiresAt, Mode=OneWay, StringFormat={}{0:MMM d}}"/></TextBlock>
                                        </Border>
                                        <Border Background="{DynamicResource Orb.Tint.InfoBg}" CornerRadius="6" Padding="6,3" Margin="6,0,0,0" BorderBrush="{DynamicResource Orb.Tint.InfoBorder}" BorderThickness="1" ToolTip="Quest type">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" FontWeight="SemiBold" Text="{Binding TaskLabel, Mode=OneWay}"/>
                                        </Border>
                                        <Border CornerRadius="6" Padding="6,3" Margin="6,0,0,0" BorderThickness="1" ToolTip="Region availability" Background="{DynamicResource Orb.Tint.SuccessBg}" BorderBrush="{DynamicResource Orb.Tint.SuccessBorder}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RegionKind}" Value="Include">
                                                            <Setter Property="Background" Value="{DynamicResource Orb.Tint.WarningBg}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Orb.Tint.WarningBorder}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RegionKind}" Value="Exclude">
                                                            <Setter Property="Background" Value="{DynamicResource Orb.Tint.DangerBg}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Orb.Tint.DangerBorder}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding RegionText, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RegionKind}" Value="Include">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RegionKind}" Value="Exclude">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="{DynamicResource Orb.Tint.DangerBg}" CornerRadius="6" Padding="6,3" Margin="6,0,0,0" BorderBrush="{DynamicResource Orb.Tint.DangerBorder}" BorderThickness="1">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NeedsSteamMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource ErrorBrush}" Text="⚠ Steam required"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Width="30" Height="30" CornerRadius="15" Cursor="Hand" Tag="{Binding}" ToolTip="Toggle completed" BorderThickness="1.5" Background="{DynamicResource Orb.ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="0,0,10,0" PreviewMouseLeftButtonDown="ToggleCompleted_Click">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Background" Value="#57F287"/><Setter Property="BorderBrush" Value="#57F287"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <!-- Always reserves space (Opacity, not Visibility) so play buttons align across cards -->
                                    <TextBlock FontSize="10" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" Cursor="Hand" HorizontalAlignment="Center" Margin="0,0,0,4"
                                               Text="Claim in Discord ↗"
                                               ToolTip="Open Discord quest home to accept &amp; claim">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Setter Property="IsHitTestVisible" Value="False"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSpoofable}" Value="False">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter Property="IsHitTestVisible" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenQuestHomeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                <Button Command="{Binding DataContext.SpoofCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand" Padding="0" Width="44" Height="44" BorderThickness="0" Background="Transparent">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="ToolTip" Value="Spoof"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSpoofable}" Value="False">
                                                    <Setter Property="ToolTip" Value="Open in Discord to watch"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" CornerRadius="11" Width="44" Height="44">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{DynamicResource SystemAccentColorPrimary}" Offset="0"/>
                                                        <GradientStop Color="{DynamicResource SystemAccentColorSecondary}" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.30" Color="{DynamicResource SystemAccentColorPrimary}"/></Border.Effect>
                                                <ui:SymbolIcon Filled="True" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Play24">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSpoofable}" Value="False">
                                                                    <Setter Property="Symbol" Value="Open24"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Effect">
                                                        <Setter.Value><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.40" Color="{DynamicResource SystemAccentColorPrimary}"/></Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.85"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- Centered overlay: spinner over dimmed list, without hiding list -->
            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" IsHitTestVisible="True" Background="#00000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <!-- Empty state on top -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoQuests, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Orb.ElevatedBrush}" HorizontalAlignment="Center" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ui:SymbolIcon Symbol="Trophy24" FontSize="28" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding EmptyText}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
