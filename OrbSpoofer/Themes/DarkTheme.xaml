<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Legacy DarkTheme — kept for backwards compat, now thin. Primary tokens live in Styles/Theme.xaml (Orb.*). -->
    <!-- Colors -->
    <Color x:Key="PrimaryColor">#5865F2</Color>
    <Color x:Key="SecondaryColor">#4752C4</Color>
    <Color x:Key="BackgroundColor">#08080A</Color>
    <Color x:Key="SurfaceColor">#0F0F11</Color>
    <Color x:Key="CardColor">#0F0F11</Color>
    <Color x:Key="BorderColor">#1E1E22</Color>
    <Color x:Key="TextPrimaryColor">#EDEDF0</Color>
    <Color x:Key="TextSecondaryColor">#9A9AA0</Color>
    <Color x:Key="TextMutedColor">#5E5E66</Color>
    <Color x:Key="ErrorColor">#ED4245</Color>
    <Color x:Key="WarningColor">#FEE75C</Color>
    <Color x:Key="SuccessColor">#57F287</Color>

    <!-- Brushes (Bridge-compat aliases — map to Orb tokens where possible) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#E67E22"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

    <!-- Fonts — Fluent Segoe UI Variable (Win11) fallback Segoe UI -->
    <FontFamily x:Key="HeaderFont">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, Courier New</FontFamily>

    <!-- Removed: PrimaryButton, GhostButton, SearchBox, ManualInputBox — now using Wpf.Ui (ui:Button, ui:TextBox PlaceholderText) -->

    <!-- Scrollbar — Aurora: thin thumb, accent hover, animado -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" VerticalAlignment="Stretch">
                            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" IsTabStop="False" Opacity="0"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" IsTabStop="False" Opacity="0"/></Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False" IsTabStop="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder" CornerRadius="5" Margin="2,1" Background="#3A3A40" Opacity="0.9">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard><Storyboard>
                                                            <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#5865F2" Duration="0:0:0.18"/>
                                                        </Storyboard></BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard><Storyboard>
                                                            <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#3A3A40" Duration="0:0:0.18"/>
                                                        </Storyboard></BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HorizontalScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Height" Value="10"/><Setter Property="MinHeight" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" VerticalAlignment="Stretch">
                            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="False" IsTabStop="False" Opacity="0"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="False" IsTabStop="False" Opacity="0"/></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb Focusable="False" IsTabStop="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="5" Margin="2,1" Background="#3A3A40" Opacity="0.9"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListBoxItem — Fluent selection con animación sutil -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,0,0,4">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="{StaticResource Orb.Card.Hover}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="border" Property="Background" Value="Transparent"/><Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SystemAccentColorPrimaryBrush}"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="border" Property="Background" Value="{StaticResource Orb.Card.Hover}"/></MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
