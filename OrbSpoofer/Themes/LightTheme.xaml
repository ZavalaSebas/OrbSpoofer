<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette — same keys as DarkTheme.xaml. -->
    <!-- Accent defaults (overridden live by ThemeManager app-level entries) -->
    <Color x:Key="SystemAccentColorPrimary">#5865F2</Color>
    <Color x:Key="SystemAccentColorSecondary">#7B83FF</Color>
    <Color x:Key="SystemAccentColorTertiary">#3A44D0</Color>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource SystemAccentColorSecondary}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource SystemAccentColorTertiary}" />
    <SolidColorBrush x:Key="Orb.SystemAccentBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="Orb.Accent.SecondaryBrush" Color="{StaticResource SystemAccentColorSecondary}" />
    <Color x:Key="Orb.Accent.Primary.Color">#5865F2</Color>
    <Color x:Key="Orb.Accent.Secondary.Color">#7B83FF</Color>
    <Color x:Key="Orb.Accent.Tertiary.Color">#3A44D0</Color>
    <Color x:Key="SystemAccentColorPrimaryFaint">#185865F2</Color>
    <Color x:Key="SystemAccentColorPrimaryTransparent">#005865F2</Color>
    <Color x:Key="SystemAccentColorSecondaryFaint">#187B83FF</Color>
    <Color x:Key="SystemAccentColorSecondaryTransparent">#007B83FF</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource SystemAccentColorPrimary}" />

    <!-- Surfaces -->
    <Color x:Key="BackgroundColor">#EFF1F4</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#DFE3E8</Color>
    <Color x:Key="Orb.Background.Primary.Color">#EFF1F4</Color>
    <Color x:Key="Orb.Background.Secondary.Color">#FFFFFF</Color>
    <Color x:Key="Orb.Background.Tertiary.Color">#F4F6F8</Color>
    <Color x:Key="Orb.Background.Quaternary.Color">#E9EDF1</Color>
    <SolidColorBrush x:Key="Orb.ElevatedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Orb.VeilBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Orb.Scrollbar.ThumbBrush" Color="#C3C9D1" />
    <!-- Tinted chip backgrounds — airy tints that keep colored text readable -->
    <SolidColorBrush x:Key="Orb.Tint.SuccessBg" Color="#DFF3E6" />
    <SolidColorBrush x:Key="Orb.Tint.SuccessBorder" Color="#A9D9BC" />
    <SolidColorBrush x:Key="Orb.Tint.WarningBg" Color="#FAECD2" />
    <SolidColorBrush x:Key="Orb.Tint.WarningBorder" Color="#DDBB7E" />
    <SolidColorBrush x:Key="Orb.Tint.DangerBg" Color="#FAE5E2" />
    <SolidColorBrush x:Key="Orb.Tint.DangerBorder" Color="#E5ACA6" />
    <SolidColorBrush x:Key="Orb.Tint.InfoBg" Color="#DFEDFA" />
    <SolidColorBrush x:Key="Orb.Tint.InfoBorder" Color="#A9CBE4" />
    <SolidColorBrush x:Key="Orb.Tint.InfoText" Color="#0F6CAB" />

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#17181D</Color>
    <Color x:Key="TextSecondaryColor">#5A5E67</Color>
    <Color x:Key="TextMutedColor">#8D929B</Color>
    <Color x:Key="Orb.Text.Primary.Color">#17181D</Color>
    <Color x:Key="Orb.Text.Secondary.Color">#5A5E67</Color>
    <Color x:Key="Orb.Text.Muted.Color">#8D929B</Color>

    <!-- Semantic (darkened for contrast on light surfaces) -->
    <Color x:Key="ErrorColor">#D92D20</Color>
    <Color x:Key="WarningColor">#9A6B00</Color>
    <Color x:Key="SuccessColor">#1E9E57</Color>

    <!-- Legacy accent colors for PrimaryBrush/SecondaryBrush -->
    <Color x:Key="PrimaryColor">#5865F2</Color>
    <Color x:Key="SecondaryColor">#4752C4</Color>

    <!-- Brushes (Bridge-compat aliases — map to Orb tokens where possible) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#E67E22"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

    <!-- Orb surfaces -->
    <SolidColorBrush x:Key="Orb.Sidebar.Background" Color="{StaticResource Orb.Background.Secondary.Color}" />
    <SolidColorBrush x:Key="Orb.Card.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Orb.Card.Hover" Color="#F4F6F8" />
    <Color x:Key="Orb.Separator.Color">#DFE3E8</Color>
    <SolidColorBrush x:Key="Orb.SeparatorBrush" Color="{StaticResource Orb.Separator.Color}" />
    <SolidColorBrush x:Key="Orb.SeparatorSubtleBrush" Color="#ECEFF2" />
    <SolidColorBrush x:Key="Orb.Glow.Accent" Color="{StaticResource SystemAccentColorPrimary}" Opacity="0.08"/>
    <RadialGradientBrush x:Key="Orb.Glow.Radial" GradientOrigin="0.5,0.15" Center="0.5,0.15" RadiusX="0.9" RadiusY="0.7">
        <GradientStop Color="{StaticResource SystemAccentColorPrimaryFaint}" Offset="0"/>
        <GradientStop Color="{StaticResource SystemAccentColorPrimaryTransparent}" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="Orb.Header.Gradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F4F6F8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Orb.Sidebar.Gradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F4F6F8" Offset="1"/>
    </LinearGradientBrush>

    <!-- Fonts — Fluent Segoe UI Variable (Win11) fallback Segoe UI -->
    <FontFamily x:Key="HeaderFont">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, Courier New</FontFamily>

</ResourceDictionary>
